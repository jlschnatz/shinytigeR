# Generated by deploy/build.R — do not edit by hand.
# Build with: docker build --platform linux/amd64 -t shinytiger deploy/

FROM --platform=linux/amd64 rocker/r-ver:4.5 
RUN apt-get update -qq && \
  apt-get install -y --no-install-recommends \
    curl \
    cmake \
    libsodium-dev \
    libuv1-dev \
    make \
    zlib1g-dev \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*
RUN RV_VERSION=$(curl -s https://api.github.com/repos/A2-ai/rv/releases/latest | grep '"tag_name"' | sed 's/.*"v\([^"]*\)".*/\1/') && \
  curl -L -o /tmp/rv.tar.gz "https://github.com/A2-ai/rv/releases/download/v${RV_VERSION}/rv-v${RV_VERSION}-x86_64-unknown-linux-gnu.tar.gz" && \
  tar -xzf /tmp/rv.tar.gz -C /usr/local/bin && \
  chmod +x /usr/local/bin/rv && \
  rm /tmp/rv.tar.gz
WORKDIR /srv
COPY rproject.toml rproject.toml
COPY rv.lock rv.lock
RUN rv sync --locked && \
  RVLIB=$(find /srv/rv/library -mindepth 3 -maxdepth 3 -type d | head -1) && \
  echo "R_LIBS_USER=$RVLIB" >> /usr/local/lib/R/etc/Renviron
COPY shinytigeR_*.tar.gz /tmp/shinytigeR.tar.gz
RUN R CMD INSTALL /tmp/shinytigeR.tar.gz && \
  rm /tmp/shinytigeR.tar.gz && \
  R -e 'library(shinytigeR)'
RUN addgroup --gid 1003 beitner && \
  adduser --shell /bin/false \
          --uid 1002 --gecos "Julia Beitner,,," \
          --gid 1003 --disabled-password beitner
RUN mkdir -p /opt/shinyapp && chown beitner:beitner /opt/shinyapp
VOLUME ["/opt/shinyapp"]
WORKDIR /opt/shinyapp
EXPOSE 3838
USER beitner
ENV "TIGER_DB_DIR"="/opt/shinyapp"
CMD ["R", "-e", "options(shiny.port=3838, shiny.host='0.0.0.0'); library(shinytigeR); shinytigeR::run_app()"] 
